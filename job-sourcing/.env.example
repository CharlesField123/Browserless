# Where this fork's Browserless server is reachable.
# Point this at your own docker run/compose instance (see ../docker-compose.job-sourcing.yml).
BROWSERLESS_WS_URL=ws://localhost:3000

# Only needed if you set the TOKEN env var on the server.
BROWSERLESS_TOKEN=

# Launch behavior for the shared browser session.
JOB_SOURCING_STEALTH=true
JOB_SOURCING_BLOCK_ADS=true
JOB_SOURCING_HEADLESS=true

# Path to your candidate profile (resume answers, contact info, question answers).
# Copy config/candidate.example.json to config/candidate.json and fill it in;
# candidate.json is gitignored so your personal data never gets committed.
CANDIDATE_PROFILE_PATH=./config/candidate.json

# Where applied/seen jobs are tracked, to avoid duplicate applications.
APPLICATION_STORE_PATH=./data/applications.json

# Safety switch. When true (the default), `apply` fills out and screenshots
# forms but never clicks the final submit button. Set to false only once
# you've reviewed the autofill output for a given board and trust it.
DRY_RUN=true

# LinkedIn's Terms of Service prohibit automated scraping/applying. The
# linkedin adapter is disabled unless you explicitly opt in, and even then
# it only ever reads your own logged-in feed/search results — it never
# automates "Easy Apply". See JOB_SOURCING.md for details.
ALLOW_LINKEDIN=false

# Per-request delay range (ms) used between navigations/actions to behave
# like a human and avoid hammering job boards.
MIN_ACTION_DELAY_MS=800
MAX_ACTION_DELAY_MS=2200
